# ==============================================================================
# E.D.E.N. (T#03) - Modelo de Topologia Estatica de Cluster (Referencia)
# ==============================================================================
# NOTA: No Trabalho 03, o servidor opera nativamente em modo Zero-Config via
# Beacon UDP (descoberta automatica de ID, Shard e Replica em LAN ou localhost),
# nao sendo necessario editar arquivos .properties para iniciar o cluster:
#   ./iniciar_cluster.sh              (6 processos locais: 3 Ativos + 3 Standbys)
#   java -cp Servidor/bin Principal   (Zero-Config autonomo na LAN/localhost)
#
# Abaixo segue a referencia de mapeamento algebrico da topologia de 6 processos:
#   Shard = (ID - 1) % 3   |   Replica = (ID - 1) / 3
#   TCP = 5000 + ID        |   UDP = 6000 + ID        |   Cluster = 7000 + ID
# ==============================================================================

# Lideres Pioneiros (Replica 0)
no.1=192.168.1.101 ; shard=0 ; replica=0 ; cluster=7001 ; tcp=5001 ; udp=6001 ; discovery=8888
no.2=192.168.1.102 ; shard=1 ; replica=0 ; cluster=7002 ; tcp=5002 ; udp=6002 ; discovery=8888
no.3=192.168.1.103 ; shard=2 ; replica=0 ; cluster=7003 ; tcp=5003 ; udp=6003 ; discovery=8888

# Replicas Standby (Replica 1)
no.4=192.168.1.104 ; shard=0 ; replica=1 ; cluster=7004 ; tcp=5004 ; udp=6004 ; discovery=8888
no.5=192.168.1.105 ; shard=1 ; replica=1 ; cluster=7005 ; tcp=5005 ; udp=6005 ; discovery=8888
no.6=192.168.1.106 ; shard=2 ; replica=1 ; cluster=7006 ; tcp=5006 ; udp=6006 ; discovery=8888

